# Local development defaults. Never commit a real production secret.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:////data/users.db
MAIL_BACKEND=console
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=no-reply@example.com
RESET_TOKEN_TTL_MINUTES=30

# Explicitly opt in to the development-only demo account.
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=dash-demo-password
DEMO_USER_FIRST_NAME=Demo
DEMO_USER_LAST_NAME=User
